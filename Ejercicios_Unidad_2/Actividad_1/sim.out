 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /OUTPUT 2 "a1";
    .port_info 3 /OUTPUT 2 "b1";
    .port_info 4 /OUTPUT 2 "c1";
