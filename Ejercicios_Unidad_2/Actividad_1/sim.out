    .scope S_0x5bcf3e859750;
T_3 ;
    %vpi_call 2 16 "$dumpfile", "tb_actividad_1.vcd" {0 0 0};
    %vpi_call 2 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5bcf3e859750 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5bcf3e885750_0, 0, 1;
    %delay 5000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5bcf3e885750_0, 0, 1;
    %vpi_call 2 22 "$display", "\000" {0 0 0};
    %vpi_call 2 23 "$display", "Tiempo |  Caso A (blocking)   |  Caso B (non-blocking)" {0 0 0};
    %vpi_call 2 24 "$display", "-------+----------------------+------------------------" {0 0 0};
    %vpi_call 2 25 "$display", "  reset|  a1=%0d b1=%0d c1=%0d         |  a2=%0d b2=%0d c2=%0d", v0x5bcf3e8851f0_0, v0x5bcf3e885370_0, v0x5bcf3e885510_0, v0x5bcf3e8852d0_0, v0x5bcf3e885440_0, v0x5bcf3e8855b0_0 {0 0 0};
    %wait E_0x5bcf3e86c300;
    %delay 1000, 0;
    %vpi_call 2 28 "$display", "  10ns |  a1=%0d b1=%0d c1=%0d         |  a2=%0d b2=%0d c2=%0d", v0x5bcf3e8851f0_0, v0x5bcf3e885370_0, v0x5bcf3e885510_0, v0x5bcf3e8852d0_0, v0x5bcf3e885440_0, v0x5bcf3e8855b0_0 {0 0 0};
    %wait E_0x5bcf3e86c300;
    %delay 1000, 0;
    %vpi_call 2 31 "$display", "  20ns |  a1=%0d b1=%0d c1=%0d         |  a2=%0d b2=%0d c2=%0d", v0x5bcf3e8851f0_0, v0x5bcf3e885370_0, v0x5bcf3e885510_0, v0x5bcf3e8852d0_0, v0x5bcf3e885440_0, v0x5bcf3e8855b0_0 {0 0 0};
    %wait E_0x5bcf3e86c300;
    %delay 1000, 0;
    %vpi_call 2 34 "$display", "  30ns |  a1=%0d b1=%0d c1=%0d         |  a2=%0d b2=%0d c2=%0d", v0x5bcf3e8851f0_0, v0x5bcf3e885370_0, v0x5bcf3e885510_0, v0x5bcf3e8852d0_0, v0x5bcf3e885440_0, v0x5bcf3e8855b0_0 {0 0 0};
    %vpi_call 2 36 "$display", "\000" {0 0 0};
    %vpi_call 2 37 "$display", "Observar: Caso B rota circularmente (1,2,3)->(2,3,1)->(3,1,2)->(1,2,3)" {0 0 0};
    %vpi_call 2 38 "$display", "          Caso A NO rota -- el orden de = importa y rompe la abstraccion." {0 0 0};
    %vpi_call 2 39 "$display", "\000" {0 0 0};
    %vpi_call 2 40 "$finish" {0 0 0};
    %end;
    .thread T_3;
