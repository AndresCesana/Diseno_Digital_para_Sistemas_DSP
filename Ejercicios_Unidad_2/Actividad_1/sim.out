    %assign/vec4 v0x5bcf3e8592d0_0, 0;
    %pushi/vec4 3, 0, 2;
    %assign/vec4 v0x5bcf3e884e40_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5bcf3e857a30_0;
    %store/vec4 v0x5bcf3e82eba0_0, 0, 2;
    %load/vec4 v0x5bcf3e884d10_0;
    %store/vec4 v0x5bcf3e857a30_0, 0, 2;
    %load/vec4 v0x5bcf3e82eba0_0;
