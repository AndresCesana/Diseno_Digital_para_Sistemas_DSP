v0x5bcf3e884fe0_0 .net "rst_n", 0 0, v0x5bcf3e885750_0;  1 drivers
E_0x5bcf3e86ba00/0 .event negedge, v0x5bcf3e884fe0_0;
E_0x5bcf3e86ba00/1 .event posedge, v0x5bcf3e884f20_0;
E_0x5bcf3e86ba00 .event/or E_0x5bcf3e86ba00/0, E_0x5bcf3e86ba00/1;
    .scope S_0x5bcf3e8598e0;
T_0 ;
    %wait E_0x5bcf3e86ba00;
    %load/vec4 v0x5bcf3e884fe0_0;
    %nor/r;
    %flag_set/vec4 8;
